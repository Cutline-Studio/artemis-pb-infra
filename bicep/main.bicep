// Artemis petabyte-scale web-data infrastructure (Azure).  Resource-group scope.
//
//   * N x ADLS Gen2 storage accounts (5 PiB default cap each -> N from scale_plan.py)
//   * user-assigned managed identity (blob data + ACR pull)
//   * Azure Container Registry (stage-module image)
//   * Azure Batch account + Spot pool (autoscale 0..maxSpotNodes) for stage tasks
//   * optional AKS cluster with a Spot node pool (alternative to Batch)
//
// Parameter files are generated by scale_plan.py: plans/main.parameters.<label>.json
// THIS REPO NEVER DEPLOYS.  To preview only (no changes):
//   az deployment group what-if -g <rg> -f bicep/main.bicep -p plans/main.parameters.9PB.json
//
// Quota/limits to raise BEFORE a real run: storage account capacity (5 PiB default),
// accounts/region (250 default), Batch Spot (low-priority) core quota, regional vCPU quota.

targetScope = 'resourceGroup'

param location string = resourceGroup().location
@maxLength(10)
param namePrefix string = 'artemis'
@minValue(1)
@maxValue(250)
@description('Number of ADLS Gen2 accounts (scale_plan.py: storage_accounts)')
param storageAccountCount int = 1
param coolAfterDays int = 30
param archiveAfterDays int = 90
@description('0 = keep raw forever; otherwise delete raw/ after N days')
param deleteRawAfterDays int = 0

@allowed([ 'Basic', 'Standard', 'Premium' ])
param acrSku string = 'Premium'

@description('Compute backend for stage tasks')
@allowed([ 'batch', 'aks', 'both' ])
param computeBackend string = 'batch'
param vmSize string = 'Standard_D32as_v5'
@description('Upper bound for autoscale (scale_plan.py: spot_nodes_needed)')
param maxSpotNodes int = 10
param taskSlotsPerNode int = 8
@description('Container image with the stage modules (pushed to the ACR)')
param stageImage string = 'artemis/stages:latest'
// Batch image: container-capable Ubuntu 22.04 (verify with `az batch pool supported-images list`)
param batchImagePublisher string = 'microsoft-dsvm'
param batchImageOffer string = 'ubuntu-hpc'
param batchImageSku string = '2204'
param batchNodeAgentSku string = 'batch.node.ubuntu 22.04'

param tags object = {
  project: 'artemis-web-data'
  managedBy: 'bicep'
}

var suffix = uniqueString(resourceGroup().id)
var acrName = take('${namePrefix}acr${suffix}', 50)
var batchName = take('${namePrefix}batch${take(suffix, 8)}', 24)

resource uami 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: '${namePrefix}-pipeline-id'
  location: location
  tags: tags
}

module storage 'modules/storage.bicep' = [for i in range(0, storageAccountCount): {
  name: 'storage-${i}'
  params: {
    name: take('${namePrefix}d${padLeft(i, 3, '0')}${suffix}', 24)
    location: location
    principalId: uami.properties.principalId
    coolAfterDays: coolAfterDays
    archiveAfterDays: archiveAfterDays
    deleteRawAfterDays: deleteRawAfterDays
    tags: tags
  }
}]

resource acr 'Microsoft.ContainerRegistry/registries@2023-07-01' = {
  name: acrName
  location: location
  tags: tags
  sku: {
    name: acrSku
  }
  properties: {
    adminUserEnabled: false
  }
}

var acrPull = subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')

resource acrPullRa 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: acr
  name: guid(acr.id, uami.id, acrPull)
  properties: {
    roleDefinitionId: acrPull
    principalId: uami.properties.principalId
    principalType: 'ServicePrincipal'
  }
}

// ---------------- Azure Batch (BatchService allocation mode) ----------------
// Since March 2026 Batch maps low-priority properties to Spot nodes in Batch-managed
// pools (https://github.com/Azure/Batch/issues/196), so targetLowPriorityNodes = Spot.
resource batch 'Microsoft.Batch/batchAccounts@2024-07-01' = if (computeBackend != 'aks') {
  name: batchName
  location: location
  tags: tags
  identity: {
    type: 'UserAssigned'
    userAssignedIdentities: { '${uami.id}': {} }
  }
  properties: {
    poolAllocationMode: 'BatchService'
    publicNetworkAccess: 'Enabled'
    allowedAuthenticationModes: [ 'AAD' ]
  }
}

// Autoscale: grow toward pending tasks, capped at maxSpotNodes; shrink to 0 when idle.
var autoScaleFormula = '''
$samples = $PendingTasks.GetSamplePercent(TimeInterval_Minute * 5);
$tasks = $samples < 70 ? max(0, $PendingTasks.GetSample(1)) : max($PendingTasks.GetSample(1), avg($PendingTasks.GetSample(TimeInterval_Minute * 5)));
$want = min(MAXNODES, (int)ceil($tasks / SLOTS));
$TargetLowPriorityNodes = $want;
$TargetDedicatedNodes = 0;
$NodeDeallocationOption = taskcompletion;
'''

resource pool 'Microsoft.Batch/batchAccounts/pools@2024-07-01' = if (computeBackend != 'aks') {
  parent: batch
  name: 'stages-spot'
  identity: {
    type: 'UserAssigned'
    userAssignedIdentities: { '${uami.id}': {} }
  }
  properties: {
    vmSize: vmSize
    taskSlotsPerNode: taskSlotsPerNode
    taskSchedulingPolicy: { nodeFillType: 'Spread' }
    interNodeCommunication: 'Disabled'
    deploymentConfiguration: {
      virtualMachineConfiguration: {
        imageReference: {
          publisher: batchImagePublisher
          offer: batchImageOffer
          sku: batchImageSku
          version: 'latest'
        }
        nodeAgentSkuId: batchNodeAgentSku
        containerConfiguration: {
          type: 'DockerCompatible'
          containerImageNames: [ '${acr.properties.loginServer}/${stageImage}' ]
          containerRegistries: [
            {
              registryServer: acr.properties.loginServer
              identityReference: { resourceId: uami.id }
            }
          ]
        }
      }
    }
    scaleSettings: {
      autoScale: {
        evaluationInterval: 'PT5M'
        formula: replace(replace(autoScaleFormula, 'MAXNODES', string(maxSpotNodes)), 'SLOTS', string(taskSlotsPerNode))
      }
    }
  }
}

// ---------------- Optional AKS with Spot node pool ----------------
resource aks 'Microsoft.ContainerService/managedClusters@2024-05-01' = if (computeBackend != 'batch') {
  name: '${namePrefix}-aks'
  location: location
  tags: tags
  identity: {
    type: 'UserAssigned'
    userAssignedIdentities: { '${uami.id}': {} }
  }
  properties: {
    dnsPrefix: '${namePrefix}-aks'
    oidcIssuerProfile: { enabled: true }
    securityProfile: { workloadIdentity: { enabled: true } }
    agentPoolProfiles: [
      {
        name: 'system'
        mode: 'System'
        count: 1
        vmSize: 'Standard_D4as_v5'
        osType: 'Linux'
      }
    ]
  }
}

resource spotPool 'Microsoft.ContainerService/managedClusters/agentPools@2024-05-01' = if (computeBackend != 'batch') {
  parent: aks
  name: 'spot'
  properties: {
    mode: 'User'
    vmSize: vmSize
    osType: 'Linux'
    scaleSetPriority: 'Spot'
    scaleSetEvictionPolicy: 'Delete'
    spotMaxPrice: -1                 // pay up to on-demand price, never evicted for price
    enableAutoScaling: true
    minCount: 0
    maxCount: maxSpotNodes
    count: 0
    nodeTaints: [ 'kubernetes.azure.com/scalesetpriority=spot:NoSchedule' ]
    nodeLabels: { workload: 'artemis-stages' }
  }
}

output managedIdentityClientId string = uami.properties.clientId
output managedIdentityId string = uami.id
output acrLoginServer string = acr.properties.loginServer
output storageAccounts array = [for i in range(0, storageAccountCount): storage[i].outputs.name]
output batchAccountEndpoint string = computeBackend != 'aks' ? batch!.properties.accountEndpoint : ''
